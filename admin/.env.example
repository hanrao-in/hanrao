# ============================================================
# HanRao Realty — Supabase Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file to version control.
# ============================================================

# ── Supabase Configuration (Required) ──
# Get this from Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vite client-side exposed keys (needed for CSRF/client client initialization)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# ── App Details ─────────────────────────────────────────────
# Used for CSRF checks and session redirect validation
APP_ORIGIN=http://localhost:8082
PORT=8082
NODE_ENV=development
